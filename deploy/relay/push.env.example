# Root-owned provider.env; keep actual private keys outside the repository.
KV_PUSH_PORT=8788
KV_FCM_SERVICE_ACCOUNT_FILE=/etc/keyvalet-push/fcm-service-account.json
# Optional APNs configuration. Files must be readable only by root/keyvalet-push.
# KV_APNS_KEY_FILE=/etc/keyvalet-push/apns.p8
# KV_APNS_TEAM=PWCRJPY7YC
# KV_APNS_KEY_ID=REPLACE_WITH_KEY_ID
# KV_APNS_TOPIC=dev.keyvalet.mobile
# KV_APNS_SANDBOX=0
