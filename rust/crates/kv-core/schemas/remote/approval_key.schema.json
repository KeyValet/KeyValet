{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalKey",
  "type": "object",
  "properties": {
    "pub": {
      "$ref": "#/$defs/PublicJwk"
    },
    "alg": {
      "enum": [
        "ES256",
        "RS256"
      ]
    }
  },
  "required": [
    "pub",
    "alg"
  ],
  "additionalProperties": true,
  "$defs": {
    "PublicJwk": {
      "type": "object",
      "properties": {
        "kty": {
          "type": "string"
        },
        "crv": {
          "type": "string"
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "n": {
          "type": "string"
        },
        "e": {
          "type": "string"
        }
      },
      "required": [
        "kty"
      ],
      "additionalProperties": true,
      "anyOf": [
        {
          "properties": {
            "kty": {
              "const": "EC"
            },
            "crv": {
              "const": "P-256"
            },
            "x": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            },
            "y": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          },
          "required": [
            "crv",
            "x",
            "y"
          ]
        },
        {
          "properties": {
            "kty": {
              "const": "RSA"
            }
          },
          "required": [
            "n",
            "e"
          ]
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "d"
            ]
          },
          {
            "required": [
              "p"
            ]
          },
          {
            "required": [
              "q"
            ]
          },
          {
            "required": [
              "dp"
            ]
          },
          {
            "required": [
              "dq"
            ]
          },
          {
            "required": [
              "qi"
            ]
          },
          {
            "required": [
              "oth"
            ]
          },
          {
            "required": [
              "k"
            ]
          }
        ]
      }
    }
  }
}
