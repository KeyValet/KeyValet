{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatusResult",
  "type": "object",
  "properties": {
    "relay": {
      "enum": [
        "connected",
        "offline"
      ]
    },
    "approvers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StatusApprover"
      }
    },
    "pending_n": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "grants_n": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unattended": {
      "type": "boolean"
    },
    "runtime_budget_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "relay",
    "approvers",
    "pending_n",
    "grants_n",
    "unattended",
    "runtime_budget_s"
  ],
  "additionalProperties": true,
  "$defs": {
    "StatusApprover": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "online"
      ],
      "additionalProperties": true
    }
  }
}
