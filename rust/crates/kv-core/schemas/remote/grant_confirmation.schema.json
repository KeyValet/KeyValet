{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GrantConfirmation",
  "type": "object",
  "properties": {
    "confirmation_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "device_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "confirmations_left": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "default": 1
    }
  },
  "required": [
    "confirmation_token",
    "expires_at",
    "device_id",
    "label"
  ],
  "additionalProperties": false
}
