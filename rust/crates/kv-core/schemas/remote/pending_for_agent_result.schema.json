{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PendingForAgentResult",
  "type": "object",
  "properties": {
    "pending": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingForAgentEntry"
      }
    }
  },
  "required": [
    "pending"
  ],
  "additionalProperties": true,
  "$defs": {
    "PendingForAgentEntry": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "expires_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "stop_hook_blocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "approval_id",
        "expires_at",
        "stop_hook_blocks"
      ],
      "additionalProperties": true
    }
  }
}
