{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requester",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "protection": {
      "$ref": "#/$defs/Protection"
    }
  },
  "required": [
    "device_id",
    "label",
    "os",
    "protection"
  ],
  "additionalProperties": true,
  "$defs": {
    "Protection": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "attestation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attestation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "Attestation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "doc": {}
      },
      "required": [
        "kind",
        "doc"
      ],
      "additionalProperties": true
    }
  }
}
