{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WaitParams",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "max_wait_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "approval_id",
    "max_wait_ms"
  ],
  "additionalProperties": true
}
