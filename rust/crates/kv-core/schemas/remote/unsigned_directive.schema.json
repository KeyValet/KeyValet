{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnsignedDirective",
  "type": "object",
  "properties": {
    "kind": {
      "const": "directive"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "iss": {
      "type": "string"
    },
    "iss_alg": {
      "enum": [
        "ES256",
        "RS256"
      ]
    },
    "iss_kind": {
      "type": "string"
    },
    "aud": {
      "type": "string"
    },
    "op": {
      "enum": [
        "set_mode",
        "revoke_grant",
        "revoke_all_grants",
        "lock",
        "set_unlock_ttl",
        "set_class",
        "set_device_label",
        "revoke_device",
        "notify",
        "query_status",
        "query_pending",
        "query_grants",
        "query_audit",
        "cancel_approval"
      ]
    },
    "args": {
      "type": "object"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "exp": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "id",
    "iss",
    "iss_alg",
    "iss_kind",
    "aud",
    "op",
    "args",
    "nonce",
    "exp"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "set_mode"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/SetModeArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "revoke_grant"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/RevokeGrantArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "revoke_all_grants"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/EmptyArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "lock"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/EmptyArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "set_unlock_ttl"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/SetUnlockTtlArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "set_class"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/SetClassArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "set_device_label"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/SetDeviceLabelArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "revoke_device"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/RevokeDeviceArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "notify"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/NotifyArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "query_status"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/EmptyArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "query_pending"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/EmptyArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "query_grants"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/EmptyArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "query_audit"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/QueryAuditArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "cancel_approval"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "#/$defs/CancelApprovalArgs"
          }
        }
      }
    }
  ],
  "not": {
    "required": [
      "sig"
    ]
  },
  "$defs": {
    "CancelApprovalArgs": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "required": [
        "approval_id"
      ],
      "additionalProperties": true
    },
    "QueryAuditArgs": {
      "type": "object",
      "properties": {
        "since": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      },
      "required": [
        "since",
        "limit"
      ],
      "additionalProperties": true
    },
    "EmptyArgs": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "NotifyArgs": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "prefer-local",
            "always-phone",
            "both"
          ]
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": true
    },
    "RevokeDeviceArgs": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        }
      },
      "required": [
        "device_id"
      ],
      "additionalProperties": true
    },
    "SetDeviceLabelArgs": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": true
    },
    "SetClassArgs": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "match": {
          "type": "object"
        },
        "exp_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "name",
        "match",
        "exp_s"
      ],
      "additionalProperties": true
    },
    "SetUnlockTtlArgs": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "seconds"
      ],
      "additionalProperties": true
    },
    "RevokeGrantArgs": {
      "type": "object",
      "properties": {
        "jti": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "required": [
        "jti"
      ],
      "additionalProperties": true
    },
    "SetModeArgs": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": true
    }
  }
}
