{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PresenceState",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "present",
        "idle",
        "away"
      ]
    },
    "since": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "signals": {
      "$ref": "#/$defs/PresenceSignals"
    }
  },
  "required": [
    "state",
    "since",
    "signals"
  ],
  "additionalProperties": true,
  "$defs": {
    "PresenceSignals": {
      "type": "object",
      "properties": {
        "graphical_session": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "screen_locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "screensaver_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "idle_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "display_connected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_awake": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_session_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_channel_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "graphical_session",
        "session_active",
        "screen_locked",
        "screensaver_active",
        "idle_seconds",
        "display_connected",
        "display_awake",
        "remote_session_active",
        "approval_channel_available"
      ],
      "additionalProperties": true
    }
  }
}
