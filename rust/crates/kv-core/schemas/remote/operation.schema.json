{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operation",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "query_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "body_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "summary",
    "method",
    "host",
    "path",
    "query_keys",
    "body_bytes"
  ],
  "additionalProperties": true
}
