{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceDeleteProof",
  "type": "object",
  "properties": {
    "action": {
      "const": "revoke_device"
    },
    "account": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    }
  },
  "required": [
    "action",
    "account",
    "by",
    "device_id",
    "challenge"
  ],
  "additionalProperties": true
}
