{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PresenceHint",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "present",
        "idle",
        "away"
      ]
    },
    "since": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sent_at": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "device_id",
    "state",
    "since",
    "sent_at"
  ],
  "additionalProperties": true
}
