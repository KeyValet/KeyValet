{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChallengeResponse",
  "type": "object",
  "properties": {
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "exp": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "challenge",
    "exp"
  ],
  "additionalProperties": true
}
