{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvelopeHeader",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "type": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "account": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "created_at": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "account",
    "from",
    "to",
    "created_at",
    "exp"
  ],
  "additionalProperties": true
}
