# Public OAuth application identifiers. Configure these on the relay process.
# Production always requires human sign-in for iOS and Android devices.
KEYVALET_GOOGLE_WEB_CLIENT_ID=
KEYVALET_GOOGLE_IOS_CLIENT_ID=
KEYVALET_GOOGLE_ANDROID_CLIENT_ID=
# Set to dev.keyvalet.mobile after enabling Sign in with Apple.
KEYVALET_APPLE_APP_ID=
KEYVALET_APPLE_SERVICES_ID=
