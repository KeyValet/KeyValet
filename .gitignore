node_modules/
dist/
.claude/
templates/n8n-catalog.json
marketing/
site/public/
__pycache__/

# Rust build and coverage artifacts.
# `target-*` directories hold Cargo output. `target`, `target-w8` and
# `target-r2c` are symlinks into those directories, so a directory-only
# rule does not match them.
rust/target
rust/target-*
rust/**/*.profraw
rust/**/*.profdata

# Local unsigned preview archives. Published packages come from GitHub Releases.
site/static/downloads/

# Local system and Python artifacts
.DS_Store
*.pyc
*.pyo

# Local execution logs
*.log
*.stdout
*.stderr

# Raw runtime experiments and captured command output
/docs/remote-approval-reports/assets/**/*.jsonl
/docs/remote-approval-reports/assets/r2d-auth/
/docs/remote-approval-reports/assets/r2d-runtime-*/
/docs/remote-approval-reports/assets/r2d-sdk*/
/docs/remote-approval-reports/assets/w8-auth-*-tests.txt
/docs/remote-approval-reports/assets/w8-auth-approval-scenario.txt

# Local environment configuration (commit example files instead)
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
